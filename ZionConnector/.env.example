APP_ENV=production
APP_DEBUG=0
CONNECTOR_PUBLIC_BASE_URL=https://connect.example.com
CONNECTOR_DATABASE_PATH=var/connector.sqlite
CONNECTOR_ADMIN_TOKEN=replace-with-a-long-random-provisioning-token

# GitHub App settings. The private key must stay outside the repository.
CONNECTOR_GITHUB_APP_ID=123456
CONNECTOR_GITHUB_APP_SLUG=zion-releasestation
CONNECTOR_GITHUB_CLIENT_ID=Iv1.replace-me
CONNECTOR_GITHUB_CLIENT_SECRET=replace-me
CONNECTOR_GITHUB_PRIVATE_KEY_PATH=/run/secrets/zion-github-app.pem

# Comma-separated HTTPS hosts allowed as ReleaseStation return targets.
CONNECTOR_RETURN_HOSTS=nas.example.com
