RewriteEngine On

# Safety fallback if Web Station is accidentally pointed at the project root.
# The preferred Apache document root is ZionConnector/public.
RewriteRule ^(?:\.env|key(?:/|$)|var(?:/|$)|vendor(?:/|$)|composer\.(?:json|lock)|phpunit\.xml) - [F,L]
RewriteCond %{REQUEST_URI} !^/public/index\.php$
RewriteRule ^ public/index.php [QSA,L]
